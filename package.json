{
  "name": "rusty-dagger-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "gameplay:typecheck": "tsc -p gameplay/tsconfig.json --noEmit",
    "gameplay:build": "tsc -p gameplay/tsconfig.json && node gameplay/scripts/materialize.mjs",
    "gameplay:check": "pnpm gameplay:build && git diff --exit-code -- data/gameplay/",
    "product:build": "ng build dagger-product",
    "product:serve": "ng serve dagger-product --host 127.0.0.1 --port 4200 --proxy-config apps/dagger-product/proxy.conf.json",
    "product:typecheck": "tsc -p apps/dagger-product/tsconfig.app.json --noEmit",
    "product:check": "pnpm product:typecheck && pnpm product:build"
  },
  "dependencies": {
    "@rusty-engine/application-host": "file:../rusty-engine/render/artifacts/application-host",
    "@rusty-engine/gameplay-rules-authoring": "file:../rusty-engine/rules/packages/gameplay-rules-authoring",
    "@rusty-engine/gameplay-rules-contracts": "file:../rusty-engine/rules/packages/gameplay-rules-contracts",
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@playwright/test": "^1.61.1",
    "typescript": "~5.9.3"
  }
}
