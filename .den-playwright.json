{
  "project": "rusty-dagger",
  "serve": {
    "command": "DAGGER_ENCOUNTER_GALLERY=1 ./scripts/serve-dagger-lab.sh {host} {port}",
    "preferredPort": 0,
    "healthUrl": "/",
    "readyText": "Dagger Lab",
    "reusePolicy": "broker_owned",
    "startupTimeout": "120s"
  },
  "playtest": {
    "startPath": "/",
    "viewport": {
      "width": 1280,
      "height": 720
    },
    "headed": false,
    "recordVideo": false
  }
}
