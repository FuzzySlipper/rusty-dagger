<Project Sdk="Microsoft.NET.Sdk">
  <!-- The commands that read the classic sources for people rather than for the data containers: image-generation
       reference exports and inventory reports. They live apart from Daggerfall.Import.Tool so that editing them
       leaves the importer revision, and so every machine's imported data, alone (src/ImporterRevision.targets). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- The import tool's option grammar, shared options and layout; the reference runs this way only. -->
    <ProjectReference Include="../Daggerfall.Import.Tool/Daggerfall.Import.Tool.csproj" />
    <ProjectReference Include="../Daggerfall.Import/Daggerfall.Import.csproj" />
    <InternalsVisibleTo Include="Daggerfall.Import.Tests" />
    <Using Include="Daggerfall.Import.Tool" />
  </ItemGroup>
</Project>
