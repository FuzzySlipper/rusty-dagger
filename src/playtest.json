{
  "project": "rusty-dagger-worldrpg",
  "serve": {
    "command": "./.runtime/runtime-pack/bin/rusty dev --project ./src/WorldRpg.Host/WorldRpg.Host.csproj --runtime ./.runtime/runtime-pack --bind-host {host} --port {port}",
    "preferredPort": 0,
    "healthUrl": "/",
    "readyText": "Rusty Product",
    "reusePolicy": "broker_owned",
    "startupTimeout": "120s"
  },
  "playtest": {
    "startPath": "/",
    "viewport": {
      "width": 1280,
      "height": 720
    },
    "headed": false,
    "recordVideo": true
  }
}
