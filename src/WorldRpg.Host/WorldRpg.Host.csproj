<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- The immutable SDK owns generated CoreCLR and NativeAOT composition
         below obj. This ordinary product project remains the one entry root. -->
    <RustyEngineProductEntryType>WorldRpg.Host.WorldRpgProduct</RustyEngineProductEntryType>
    <RustyEngineProductId>rusty-dagger-worldrpg</RustyEngineProductId>
    <RustyEngineProductTitle>Rusty Dagger / WorldRpg</RustyEngineProductTitle>
    <RustyEngineProductDefaultWorldLights>disabled</RustyEngineProductDefaultWorldLights>
    <RustyEngineProductUiRoot>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'product-ui'))</RustyEngineProductUiRoot>
    <RustyEngineProductContentRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../content'))</RustyEngineProductContentRoot>
    <RustyEngineProductUiEntry>main.js</RustyEngineProductUiEntry>
    <!-- TypeScript builds only the product-owned DOM companion. The runtime
         pack provides the browser shell, renderer, and transport. The SDK
         reruns this only when a file under ../ui or a listed dependency
         changes, so C#-only edits skip it and UI edits skip the C# build. -->
    <RustyEngineProductUiSourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../ui'))</RustyEngineProductUiSourceRoot>
    <RustyEngineProductUiBuildCommand>node &quot;$(MSBuildThisFileDirectory)../../node_modules/typescript/bin/tsc&quot; -p &quot;$(MSBuildThisFileDirectory)../ui/tsconfig.json&quot; --outDir &quot;$(RustyEngineProductUiRoot)&quot;</RustyEngineProductUiBuildCommand>
    <RustyEngineProductUiProjectionStream>dagger.hud</RustyEngineProductUiProjectionStream>
    <RustyEngineProductUiProjectionContract>dagger.ui.snapshot.v1</RustyEngineProductUiProjectionContract>
    <RustyEngineProductLifecycleMode>realtime</RustyEngineProductLifecycleMode>
    <RustyEngineProductFixedStepHz>60</RustyEngineProductFixedStepHz>
    <RustyEngineProductFixedStepMaxCatchUpSteps>4</RustyEngineProductFixedStepMaxCatchUpSteps>
    <RustyEngineWatchPaths>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'));$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../WorldRpg.Kit'));$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../WorldRpg.Rulesets.Daggerfall'));$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../ui'));$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../content'))</RustyEngineWatchPaths>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../WorldRpg.Kit/WorldRpg.Kit.csproj" />
    <ProjectReference Include="../WorldRpg.Rulesets.Daggerfall/WorldRpg.Rulesets.Daggerfall.csproj" />
    <PackageReference Include="Rusty.Engine" Version="[$(RustyEnginePackageVersion)]">
      <ExcludeAssets Condition="'$(RustyEngineUseSourceDevelopment)' == 'true'">compile;runtime</ExcludeAssets>
    </PackageReference>
    <RustyEngineProductInputIntent Include="move.forward" Value="digital" />
    <RustyEngineProductInputIntent Include="move.left" Value="digital" />
    <RustyEngineProductInputIntent Include="move.backward" Value="digital" />
    <RustyEngineProductInputIntent Include="move.right" Value="digital" />
    <RustyEngineProductInputIntent Include="run" Value="digital" />
    <RustyEngineProductInputIntent Include="crouch" Value="digital" />
    <RustyEngineProductInputIntent Include="jump" Value="digital" />
    <RustyEngineProductInputIntent Include="dagger.ui" Value="payload:dagger.ui.action.v1" />
    <RustyEngineProductInputIntent Include="toggle-weapon" Value="digital" />
    <RustyEngineProductInputMapping Include="toggle-weapon.key-z" Intent="toggle-weapon" Trigger="key:key-z:pressed" />
    <RustyEngineProductInputIntent Include="inventory" Value="digital" />
    <RustyEngineProductInputIntent Include="character" Value="digital" />
    <RustyEngineProductInputIntent Include="menu" Value="digital" />
    <RustyEngineProductInputIntent Include="spell" Value="digital" />
    <RustyEngineProductInputIntent Include="rest" Value="digital" />
    <RustyEngineProductInputIntent Include="map" Value="digital" />
    <RustyEngineProductInputIntent Include="transport" Value="digital" />
    <RustyEngineProductInputIntent Include="attack" Value="digital" />
    <RustyEngineProductInputMapping Include="attack.primary" Intent="attack" Trigger="pointer-button:primary:pressed" />
    <RustyEngineProductInputIntent Include="interact" Value="digital" />
    <RustyEngineProductInputMapping Include="interact.key-f" Intent="interact" Trigger="key:key-f:pressed" />
    <RustyEngineProductInputMapping Include="move.forward.key-w" Intent="move.forward" Trigger="key:key-w:held" />
    <RustyEngineProductInputMapping Include="move.left.key-a" Intent="move.left" Trigger="key:key-a:held" />
    <RustyEngineProductInputMapping Include="move.backward.key-s" Intent="move.backward" Trigger="key:key-s:held" />
    <RustyEngineProductInputMapping Include="move.right.key-d" Intent="move.right" Trigger="key:key-d:held" />
    <!-- The complete sound catalog remains in the eager snapshot. Both generated WAV projections
         are independently opened at the first cue, so neither body enters that startup snapshot. -->
    <RustyEngineContentBundle Include="daggerfall.classic-audio" Root="worldrpg/media/audio/clips" />
    <!-- The score is one product-wide bundle: its manifest sits above the root and stays eager while the
         cue bodies are opened on the first cue, exactly as the effect clips above are. -->
    <RustyEngineContentBundle Include="daggerfall.music" Root="worldrpg/media/music/clips" />
    <RustyEngineContentBundle Include="daggerfall.sky" Root="worldrpg/media/sky/resources" />
    <RustyEngineContentBundle Include="daggerfall.cinematics" Root="worldrpg/media/cinematics" />
    <!-- One bundle per site: its id is the site payload's world.audioBundle and its root is the audio
         clips under that payload's publicationRoot. The SDK stages exactly the items declared here, one
         per bundle, so a new site adds its one line; a ruleset test checks each payload against it. -->
    <RustyEngineContentBundle Include="daggerfall.privateers-hold-audio" Root="worldrpg/imports/privateers-hold/media/audio/clips" />
    <RustyEngineContentBundle Include="daggerfall.castle-necromoghan-audio" Root="worldrpg/imports/castle-necromoghan/media/audio/clips" />
    <RustyEngineContentBundle Include="daggerfall.charing-exterior-audio" Root="worldrpg/imports/charing/exterior/media/audio/clips" />
    <RustyEngineContentBundle Include="daggerfall.charing-interior-1-1-0-audio" Root="worldrpg/imports/charing/interior-1-1-0/media/audio/clips" />
    <RustyEngineContentBundle Include="daggerfall.charing-interior-3-4-0-audio" Root="worldrpg/imports/charing/interior-3-4-0/media/audio/clips" />
    <RustyEngineContentBundle Include="daggerfall.charing-interior-3-1-13-audio" Root="worldrpg/imports/charing/interior-3-1-13/media/audio/clips" />
    <RustyEngineContentBundle Include="daggerfall.charing-interior-4-2-0-audio" Root="worldrpg/imports/charing/interior-4-2-0/media/audio/clips" />
    <RustyEngineContentBundle Include="daggerfall.charing-interior-1-5-17-audio" Root="worldrpg/imports/charing/interior-1-5-17/media/audio/clips" />
    <RustyEngineContentBundle Include="daggerfall.charing-interior-3-2-14-audio" Root="worldrpg/imports/charing/interior-3-2-14/media/audio/clips" />
    <RustyEngineContentBundle Include="daggerfall.small-ship-audio" Root="worldrpg/imports/small-ship/exterior/media/audio/clips" />
    <RustyEngineContentBundle Include="daggerfall.large-ship-audio" Root="worldrpg/imports/large-ship/exterior/media/audio/clips" />
  </ItemGroup>

  <!-- Content derived from the operator's Arena2 files is not tracked; scripts/regenerate-content.sh
       writes it. Every bundle root declared above is generated, so a missing one means the tree was
       never regenerated (or the run did not finish). Staging would otherwise publish a product whose
       composition fails at session start, so it stops here with the command named. -->
  <Target Name="RequireRegeneratedContent" BeforeTargets="StageRustyEngineProductAssets">
    <ItemGroup>
      <_WorldRpgMissingGeneratedRoot Include="@(RustyEngineContentBundle->'%(Root)')"
                                     Condition="!Exists('$(RustyEngineProductContentRoot)/%(RustyEngineContentBundle.Root)')" />
    </ItemGroup>
    <Error Condition="'@(_WorldRpgMissingGeneratedRoot)' != ''"
           Text="The generated content is absent from $(RustyEngineProductContentRoot) (missing: @(_WorldRpgMissingGeneratedRoot, ', ')). It is derived from your Daggerfall files and is not tracked: supply local/arena2 (and local/Sound), then run scripts/regenerate-content.sh." />
  </Target>

  <ItemGroup>
    <RustyEngineProductUiInput Include="$(MSBuildThisFileDirectory)../../package.json;$(MSBuildThisFileDirectory)../../package-lock.json;$(MSBuildThisFileDirectory)../../tsconfig.base.json;$(RustyEngineProductUiTypes)" />
  </ItemGroup>
  <!-- The UI compiles against the pair's declarations, copied beside its
       sources. The copy is made only when their content differs, so machines
       sharing a checkout (whose package caches give the file different times)
       do not rewrite it for each other. MSBuild copies, so the command above
       runs the same under cmd.exe and sh. -->
  <Target Name="CopyEngineUiTypes" BeforeTargets="BuildRustyEngineProductUi">
    <PropertyGroup>
      <_EngineUiTypesCopy>$(MSBuildThisFileDirectory)../ui/engine-types/rusty-engine-product-ui.d.ts</_EngineUiTypesCopy>
    </PropertyGroup>
    <GetFileHash Files="$(RustyEngineProductUiTypes)">
      <Output TaskParameter="Hash" PropertyName="_EngineUiTypesHash" />
    </GetFileHash>
    <GetFileHash Files="$(_EngineUiTypesCopy)" Condition="Exists('$(_EngineUiTypesCopy)')">
      <Output TaskParameter="Hash" PropertyName="_EngineUiTypesCopyHash" />
    </GetFileHash>
    <Copy SourceFiles="$(RustyEngineProductUiTypes)" DestinationFiles="$(_EngineUiTypesCopy)" Condition="'$(_EngineUiTypesHash)' != '$(_EngineUiTypesCopyHash)'" />
    <ItemGroup>
      <ProductUiStylesheet Include="$(MSBuildThisFileDirectory)../ui/*.css" />
    </ItemGroup>
    <Copy SourceFiles="@(ProductUiStylesheet)" DestinationFolder="$(RustyEngineProductUiRoot)" SkipUnchangedFiles="true" />
  </Target>
</Project>
