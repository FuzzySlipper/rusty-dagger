<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- The immutable SDK owns generated CoreCLR and NativeAOT composition
         below obj. This ordinary product project remains the one entry root. -->
    <RustyEngineProductEntryType>WorldRpg.Host.WorldRpgProduct</RustyEngineProductEntryType>
    <RustyEngineProductId>rusty-dagger-worldrpg</RustyEngineProductId>
    <RustyEngineProductTitle>Rusty Dagger / WorldRpg</RustyEngineProductTitle>
    <RustyEngineProductUiRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../ui/generated'))</RustyEngineProductUiRoot>
    <RustyEngineProductContentRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../content'))</RustyEngineProductContentRoot>
    <RustyEngineProductUiEntry>main.js</RustyEngineProductUiEntry>
    <RustyEngineProductUiProjectionStream>dagger.hud</RustyEngineProductUiProjectionStream>
    <RustyEngineProductUiProjectionContract>dagger.ui.snapshot.v1</RustyEngineProductUiProjectionContract>
    <RustyEngineProductLifecycleMode>realtime</RustyEngineProductLifecycleMode>
    <RustyEngineProductFixedStepHz>60</RustyEngineProductFixedStepHz>
    <RustyEngineProductFixedStepMaxCatchUpSteps>4</RustyEngineProductFixedStepMaxCatchUpSteps>
    <RustyEngineWatchPaths>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'));$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../WorldRpg.Kit'));$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../WorldRpg.Rulesets.Daggerfall'));$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../ui'));$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../content'))</RustyEngineWatchPaths>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../WorldRpg.Kit/WorldRpg.Kit.csproj" />
    <ProjectReference Include="../WorldRpg.Rulesets.Daggerfall/WorldRpg.Rulesets.Daggerfall.csproj" />
    <PackageReference Include="Rusty.Engine" Version="$(RustyEnginePackageVersion)">
      <ExcludeAssets Condition="'$(RustyEngineUseSourceDevelopment)' == 'true'">compile;runtime</ExcludeAssets>
    </PackageReference>
    <RustyEngineProductInputIntent Include="move.forward" Value="digital" />
    <RustyEngineProductInputIntent Include="move.left" Value="digital" />
    <RustyEngineProductInputIntent Include="move.backward" Value="digital" />
    <RustyEngineProductInputIntent Include="move.right" Value="digital" />
    <RustyEngineProductInputIntent Include="dagger.ui" Value="payload:dagger.ui.action.v1" />
    <RustyEngineProductInputIntent Include="toggle-weapon" Value="digital" />
    <RustyEngineProductInputMapping Include="toggle-weapon.key-z" Intent="toggle-weapon" Trigger="key:key-z:pressed" />
    <RustyEngineProductInputIntent Include="inventory" Value="digital" />
    <RustyEngineProductInputIntent Include="character" Value="digital" />
    <RustyEngineProductInputIntent Include="menu" Value="digital" />
    <RustyEngineProductInputIntent Include="spell" Value="digital" />
    <RustyEngineProductInputIntent Include="rest" Value="digital" />
    <RustyEngineProductInputIntent Include="map" Value="digital" />
    <RustyEngineProductInputIntent Include="transport" Value="digital" />
    <RustyEngineProductInputIntent Include="attack" Value="digital" />
    <RustyEngineProductInputMapping Include="attack.primary" Intent="attack" Trigger="pointer-button:primary:pressed" />
    <RustyEngineProductInputIntent Include="interact" Value="digital" />
    <RustyEngineProductInputMapping Include="interact.key-f" Intent="interact" Trigger="key:key-f:pressed" />
    <RustyEngineProductInputMapping Include="move.forward.key-w" Intent="move.forward" Trigger="key:key-w:held" />
    <RustyEngineProductInputMapping Include="move.left.key-a" Intent="move.left" Trigger="key:key-a:held" />
    <RustyEngineProductInputMapping Include="move.backward.key-s" Intent="move.backward" Trigger="key:key-s:held" />
    <RustyEngineProductInputMapping Include="move.right.key-d" Intent="move.right" Trigger="key:key-d:held" />
    <!-- The complete sound catalog remains in the eager snapshot. Both generated WAV projections
         are independently opened at the first cue, so neither body enters that startup snapshot. -->
    <RustyEngineContentBundle Include="daggerfall.classic-audio" Root="worldrpg/media/audio/clips" />
    <RustyEngineContentBundle Include="daggerfall.cinematics" Root="worldrpg/media/cinematics" />
    <RustyEngineContentBundle Include="daggerfall.privateers-hold-audio" Root="worldrpg/imports/privateers-hold/media/audio/clips" />
  </ItemGroup>

  <!-- TypeScript builds only the product-owned DOM companion. The runtime
       pack provides the browser shell, renderer, and transport. -->
  <Target Name="BuildWorldRpgProductUi" BeforeTargets="GenerateRustyEngineProductComposition">
    <MakeDir Directories="$(RustyEngineProductUiRoot)" />
    <Exec Command="npm --prefix &quot;$(MSBuildThisFileDirectory)../..&quot; exec -- tsc --target ES2022 --module ES2022 --moduleResolution bundler --strict --noEmitOnError --outDir &quot;$(RustyEngineProductUiRoot)&quot; &quot;$(MSBuildThisFileDirectory)../ui/main.ts&quot;" />
    <ItemGroup>
      <ProductUiStylesheet Include="$(MSBuildThisFileDirectory)../ui/*.css" />
      <!-- Every UI artifact, including the authored inventory skins, is published content the product
           reads by media identity and delivers in its projection, so nothing is staged here. -->
    </ItemGroup>
    <Copy SourceFiles="@(ProductUiStylesheet)" DestinationFolder="$(RustyEngineProductUiRoot)" />
  </Target>
</Project>
