<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../WorldRpg.Kit/WorldRpg.Kit.csproj" />
    <PackageReference Include="Rusty.Engine" Version="[$(RustyEnginePackageVersion)]">
      <ExcludeAssets Condition="'$(RustyEngineUseSourceDevelopment)' == 'true'">compile;runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
  <!-- The importer revision the data container must record to be current for this build. -->
  <PropertyGroup>
    <ImporterRevisionNamespace>WorldRpg.Rulesets.Daggerfall.Content</ImporterRevisionNamespace>
    <ImporterRevisionClass>DaggerfallImporterRevision</ImporterRevisionClass>
    <ImporterRevisionModifier>internal</ImporterRevisionModifier>
  </PropertyGroup>
  <Import Project="../ImporterRevision.targets" />
</Project>
