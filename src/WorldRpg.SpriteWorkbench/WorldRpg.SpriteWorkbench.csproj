<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- The workbench remains an ordinary safe C# product; the SDK generates
         its bind entry point, and this project never carries a checked
         bootstrap. -->
    <RustyEngineProductEntryType>WorldRpg.SpriteWorkbench.SpriteWorkbenchProduct</RustyEngineProductEntryType>
    <RustyEngineProductId>worldrpg-sprite-workbench</RustyEngineProductId>
    <RustyEngineProductTitle>WorldRpg Sprite Workbench</RustyEngineProductTitle>
    <RustyEngineProductUiRoot>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'product-ui'))</RustyEngineProductUiRoot>
    <RustyEngineProductContentRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)workbench-content'))</RustyEngineProductContentRoot>
    <RustyEngineProductUiEntry>workbench.js</RustyEngineProductUiEntry>
    <!-- The SDK reruns tsc only when ../sprite-ui or a listed input changes. -->
    <RustyEngineProductUiSourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../sprite-ui'))</RustyEngineProductUiSourceRoot>
    <RustyEngineProductUiBuildCommand>node &quot;$(MSBuildThisFileDirectory)../../node_modules/typescript/bin/tsc&quot; -p &quot;$(MSBuildThisFileDirectory)../sprite-ui/tsconfig.json&quot; --outDir &quot;$(RustyEngineProductUiRoot)&quot;</RustyEngineProductUiBuildCommand>
    <RustyEngineProductUiProjectionStream>worldrpg.sprite-workbench</RustyEngineProductUiProjectionStream>
    <RustyEngineProductUiProjectionContract>worldrpg.sprite-workbench.snapshot.v1</RustyEngineProductUiProjectionContract>
    <RustyEngineProductLifecycleMode>realtime</RustyEngineProductLifecycleMode>
    <RustyEngineProductFixedStepHz>60</RustyEngineProductFixedStepHz>
    <RustyEngineProductFixedStepMaxCatchUpSteps>4</RustyEngineProductFixedStepMaxCatchUpSteps>
    <RustyEngineWatchPaths>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'));$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../sprite-ui'));$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)workbench-content'))</RustyEngineWatchPaths>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WorldRpg.Kit/WorldRpg.Kit.csproj" />
    <ProjectReference Include="../WorldRpg.SpriteAuthoring/WorldRpg.SpriteAuthoring.csproj" />
    <PackageReference Include="Rusty.Engine" Version="[$(RustyEnginePackageVersion)]">
      <ExcludeAssets Condition="'$(RustyEngineUseSourceDevelopment)' == 'true'">compile;runtime</ExcludeAssets>
    </PackageReference>
    <RustyEngineProductInputIntent Include="sprite-workbench" Value="payload:worldrpg.sprite-workbench.intent.v1" />
  </ItemGroup>

  <ItemGroup>
    <RustyEngineProductUiInput Include="$(MSBuildThisFileDirectory)../../package.json;$(MSBuildThisFileDirectory)../../package-lock.json;$(MSBuildThisFileDirectory)../../tsconfig.base.json;$(RustyEngineProductUiTypes)" />
  </ItemGroup>

  <!-- The workbench shows the staged publication's atlas pages and its
       stylesheet from the UI root. Copying them is not a compile step, so it
       runs before the SDK's UI build rather than inside its command. -->
  <Target Name="StageSpriteWorkbenchUiAssets" BeforeTargets="BuildRustyEngineProductUi">
    <MakeDir Directories="$(RustyEngineProductUiRoot)" />
    <ItemGroup>
      <WorkbenchAtlas Include="$(RustyEngineProductContentRoot)/**/*.png" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkbenchAtlas)" DestinationFiles="@(WorkbenchAtlas->'$(RustyEngineProductUiRoot)/atlas/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../sprite-ui/workbench.css" DestinationFolder="$(RustyEngineProductUiRoot)" Condition="Exists('../sprite-ui/workbench.css')" SkipUnchangedFiles="true" />
  </Target>
  <!-- The UI compiles against the pair's declarations, copied beside its
       sources; copying is MSBuild's, so the command above runs the same under
       cmd.exe and sh. -->
  <Target Name="CopyEngineUiTypes" BeforeTargets="BuildRustyEngineProductUi">
    <Copy SourceFiles="$(RustyEngineProductUiTypes)" DestinationFolder="$(MSBuildThisFileDirectory)../sprite-ui/engine-types" SkipUnchangedFiles="true" />
  </Target>
</Project>
