<Project>
  <!-- The importer revision: one SHA-256 over what the import reads from the repository, so a build of the same
       importer source and data names the same revision on any machine, with or without a Git checkout, and any edit
       that can change the imported data names another. The import tool records it in the data container it packs;
       a project that must say whether that container is current imports this file and compares it with the same value.

       A project sets ImporterRevisionNamespace and ImporterRevisionClass (and ImporterRevisionModifier when the
       class is not public) and declares the partial class; this target adds the constant `StampedRevision` to it.
       The inputs are the import pipeline's source (src/Daggerfall.Import and src/Daggerfall.Import.Tool, which
       holds only the import, its steps and pack, and in inputs/ the tracked files its steps read: the source
       inventory and our tables taken from Daggerfall Unity) and the authored UI originals with their manifest. The
       tracked terrain bake in inputs/relief is left out: the relief step takes it only when its record names the bake
       this code would make from the player's files, so it cannot change what the import writes. The
       import reads no Daggerfall Unity file and never the authored base payload; the ruleset joins the base pack's
       sections to the imported ones when it loads. A command that does not feed the containers, the donor drift
       check among them, lives in src/Daggerfall.Source.Tool, outside the hash. Build output is
       excluded; files are hashed by path and content with CRLF read as LF, so a Windows checkout of the same commit
       names the same revision. Daggerfall.Import.Tests' ImporterRevisionTests fail when a source file or repository
       path the import reaches lies outside these inputs. The generated file is rewritten only when the value
       changes, so an unchanged revision does not recompile. -->
  <UsingTask TaskName="ComputeImporterRevision" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Root ParameterType="System.String" Required="true" />
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Revision ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // Inline tasks compile against .NET Standard, so the digest and relative-path helpers are spelled out.
        string root = Path.GetFullPath(Root).TrimEnd('/', '\\') + "/";
        Func<byte[], string> hex = bytes => BitConverter.ToString(bytes).Replace("-", "").ToLowerInvariant();
        var lines = new StringBuilder();
        using (SHA256 sha = SHA256.Create())
        {
            foreach (var entry in Files.Select(item => Path.GetFullPath(item.ItemSpec)).Distinct(StringComparer.Ordinal)
                         .Select(full => new { Relative = full.Replace('\\', '/').Substring(root.Length), Full = full })
                         .OrderBy(entry => entry.Relative, StringComparer.Ordinal))
            {
                byte[] bytes = File.ReadAllBytes(entry.Full);
                var normalized = new MemoryStream(bytes.Length);
                for (int index = 0; index < bytes.Length; index++)
                {
                    if (bytes[index] == (byte)'\r' && index + 1 < bytes.Length && bytes[index + 1] == (byte)'\n') continue;
                    normalized.WriteByte(bytes[index]);
                }
                lines.Append(entry.Relative).Append('\0').Append(hex(sha.ComputeHash(normalized.ToArray()))).Append('\n');
            }
            Revision = hex(sha.ComputeHash(Encoding.UTF8.GetBytes(lines.ToString())));
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="StampImporterRevision" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_ImporterRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</_ImporterRepositoryRoot>
      <_ImporterRevisionFile>$(IntermediateOutputPath)ImporterRevision.g.cs</_ImporterRevisionFile>
      <ImporterRevisionModifier Condition="'$(ImporterRevisionModifier)' == ''">public</ImporterRevisionModifier>
    </PropertyGroup>
    <ItemGroup>
      <_ImporterRevisionInput Include="$(_ImporterRepositoryRoot)/src/Daggerfall.Import/**;$(_ImporterRepositoryRoot)/src/Daggerfall.Import.Tool/**"
                              Exclude="$(_ImporterRepositoryRoot)/src/*/bin/**;$(_ImporterRepositoryRoot)/src/*/obj/**;$(_ImporterRepositoryRoot)/src/Daggerfall.Import.Tool/inputs/relief/**" />
      <_ImporterRevisionInput Include="$(_ImporterRepositoryRoot)/content/worldrpg/packs/daggerfall.art-replacements/authored-ui/**" />
    </ItemGroup>
    <ComputeImporterRevision Root="$(_ImporterRepositoryRoot)" Files="@(_ImporterRevisionInput)">
      <Output TaskParameter="Revision" PropertyName="_ImporterRevision" />
    </ComputeImporterRevision>
    <WriteLinesToFile File="$(_ImporterRevisionFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// &lt;auto-generated/&gt;;namespace $(ImporterRevisionNamespace)%3B;$(ImporterRevisionModifier) static partial class $(ImporterRevisionClass) { private const string StampedRevision = &quot;$(_ImporterRevision)&quot;%3B }" />
    <ItemGroup>
      <Compile Include="$(_ImporterRevisionFile)" />
      <FileWrites Include="$(_ImporterRevisionFile)" />
    </ItemGroup>
  </Target>

  <!-- The relief bake's revision, the same digest over the bake's own source alone (src/Daggerfall.Import/Relief), so the
       tracked terrain bake stays valid across every other importer edit and goes stale on any edit to the bake. A project
       sets StampReliefBakeRevision to true to have the constant `StampedReliefBakeRevision` added to its revision class.
       Daggerfall.Import.Tests' ReliefBakeRevisionTests compile that folder alone, so the bake cannot run importer code
       outside it. -->
  <Target Name="StampReliefBakeRevision" BeforeTargets="CoreCompile" Condition="'$(StampReliefBakeRevision)' == 'true'">
    <PropertyGroup>
      <_ReliefBakeRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</_ReliefBakeRepositoryRoot>
      <_ReliefBakeRevisionFile>$(IntermediateOutputPath)ReliefBakeRevision.g.cs</_ReliefBakeRevisionFile>
      <ImporterRevisionModifier Condition="'$(ImporterRevisionModifier)' == ''">public</ImporterRevisionModifier>
    </PropertyGroup>
    <ItemGroup>
      <_ReliefBakeInput Include="$(_ReliefBakeRepositoryRoot)/src/Daggerfall.Import/Relief/**" />
    </ItemGroup>
    <ComputeImporterRevision Root="$(_ReliefBakeRepositoryRoot)" Files="@(_ReliefBakeInput)">
      <Output TaskParameter="Revision" PropertyName="_ReliefBakeRevision" />
    </ComputeImporterRevision>
    <WriteLinesToFile File="$(_ReliefBakeRevisionFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// &lt;auto-generated/&gt;;namespace $(ImporterRevisionNamespace)%3B;$(ImporterRevisionModifier) static partial class $(ImporterRevisionClass) { private const string StampedReliefBakeRevision = &quot;$(_ReliefBakeRevision)&quot;%3B }" />
    <ItemGroup>
      <Compile Include="$(_ReliefBakeRevisionFile)" />
      <FileWrites Include="$(_ReliefBakeRevisionFile)" />
    </ItemGroup>
  </Target>
</Project>
