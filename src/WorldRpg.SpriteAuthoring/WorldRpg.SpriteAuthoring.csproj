<Project Sdk="Microsoft.NET.Sdk">
  <!-- The product-neutral sprite-authoring contract shared by the offline
       importer and the developer-only sprite workbench. It references nothing:
       the importer stays free of the Engine package, and the workbench never
       reaches the importer through it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
