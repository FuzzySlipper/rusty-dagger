<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- The drift check builds the base pack's internal text with the import's own text tokenizer. -->
    <InternalsVisibleTo Include="Daggerfall.Source.Tool" />
  </ItemGroup>
  <!-- Stamps ImporterBuild.Revision, the importer revision the data container records. -->
  <PropertyGroup>
    <ImporterRevisionNamespace>Daggerfall.Import</ImporterRevisionNamespace>
    <ImporterRevisionClass>ImporterBuild</ImporterRevisionClass>
  </PropertyGroup>
  <Import Project="../ImporterRevision.targets" />
</Project>
