<Project Sdk="Microsoft.NET.Sdk">
  <!-- The political board game: seats playing cards on the Bay's regions, one turn a week. It stands alone, with no
       Engine, Kit or ruleset reference, so it runs and is tested without the game; the session drives it later. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WorldRpg.Politics.Tests" />
    <!-- The canon start and cards are content of the base pack, which the game reads. The CLI and the tests read the
         same files beside this library. -->
    <None Include="../../content/worldrpg/packs/daggerfall.base/world/iliac-bay.board.json" Link="canon/iliac-bay.board.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../content/worldrpg/packs/daggerfall.base/world/iliac-bay.cards.json" Link="canon/iliac-bay.cards.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
