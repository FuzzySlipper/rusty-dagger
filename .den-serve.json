{
  "project": "rusty-dagger",
  "serve": {
    "command": "PATH=\"$HOME/.local/bin:$PATH\" exec rusty dev --project ./src/WorldRpg.Host/WorldRpg.Host.csproj --live-debug --bind-host {host} --port {port} --diagnostics-log {session_dir}/rusty-engine-diagnostics.ndjson",
    "preferredPort": 4174,
    "healthUrl": "/",
    "readyText": "Rusty Product Host",
    "reusePolicy": "broker_owned",
    "startupTimeout": "180s",
    "healthInterval": "250ms"
  }
}
