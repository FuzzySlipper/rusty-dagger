<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Installed, immutable Engine SDK artifact. Normal product builds never
         resolve an adjacent Engine checkout as a package source. -->
    <add key="rusty-engine-sdk" value=".runtime/sdk-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
