 #include "Common.h"
 
 #include <cooperative_groups.h>
+#if !defined(USE_ROCM)
 #include <cooperative_groups/reduce.h>
+#define GS_CG_REDUCE cooperative_groups::reduce
+#define GS_CG_PLUS cooperative_groups::plus
+#define GS_CG_GREATER cooperative_groups::greater
+#define GS_CG_LABELED cooperative_groups::labeled_partition
+#else
+// HIP has no cooperative_groups reduce: a shuffle-xor tree over the warp tile (den-m5 gfx1151, wave32, 2026-11-18)
+namespace gs_cg {
+template <typename T> struct plus { __device__ __forceinline__ T operator()(T a, T b) const { return a + b; } };
+template <typename T> struct greater { __device__ __forceinline__ T operator()(T a, T b) const { return a > b ? a : b; } };
+template <typename Tile, typename T, typename Op>
+__device__ __forceinline__ T reduce(const Tile &t, T v, Op op) {
+    for (int o = t.size() / 2; o > 0; o /= 2) v = op(v, __shfl_xor(v, o, t.size()));
+    return v;
+}
+// no labeled_partition on HIP: each thread is its own group, so warpSum is a no-op and every thread does its own atomic add
+struct single { __device__ __forceinline__ unsigned size() const { return 1; } __device__ __forceinline__ unsigned thread_rank() const { return 0; } };
+template <typename Tile, typename L> __device__ __forceinline__ single labeled_partition(const Tile &, L) { return single{}; }
+template <typename T, typename Op> __device__ __forceinline__ T reduce(const single &, T v, Op) { return v; }
+}
+#define GS_CG_LABELED gs_cg::labeled_partition
+#define GS_CG_REDUCE gs_cg::reduce
+#define GS_CG_PLUS gs_cg::plus
+#define GS_CG_GREATER gs_cg::greater
+#endif
 
