    if n.cfg.get('sides') or n.cfg.get('side'):   # four (or three) references: at 1280 px they fit the 5090 at 1920 (9 min, peak 31.7 GB;
        side['REF_SIZE'] = str(n.cfg.get('ref_size', 1280))   # the CMS views are 832x1216; no visible loss against 1920 px refs on a Halo,
                                                               # 2 h 51 min - npc-467, Patch 2026-11-25). npc.json "ref_size": 0 for full size
        if side['REF_SIZE'] == '0':
