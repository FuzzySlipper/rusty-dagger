        side['SIDE_GUIDES'] = ' '.join(f"{v}:{18 if v == 'right' else 54}" for v in n.cfg['sides'])
    sh(['bash', 'authoring/tools/people/splat/scaffold/guided_clip.sh', n.work, n.rid, 'clip', str(sz)], env={**n.env, **n.key_env, **n.gpu_env, **side})
