def sh(cmd, log=None, env=None, check=True):
    print('+', cmd if isinstance(cmd, str) else ' '.join(map(str, cmd)), flush=True)
    e = dict(os.environ, **(env or {}))
    if log:
        with open(log, 'a') as fh:
            r = subprocess.run(cmd, shell=isinstance(cmd, str), cwd=REPO, env=e, stdout=fh, stderr=subprocess.STDOUT)
    else:
        r = subprocess.run(cmd, shell=isinstance(cmd, str), cwd=REPO, env=e)
    if check and r.returncode:
        raise SystemExit(f'static-npc: failed (rc {r.returncode})' + (f'; see {log}' if log else ''))
    return r.returncode


class Npc:
    def __init__(self, cid):
        self.id = cid
        self.rid = cid.removeprefix('npc-')                 # the run id under work/ (NNN; bake id NNN-A)
        if cid.startswith('creature-'):                     # creature-NNN -> cNNN: the batch scripts read run ids as NNN-X (2026-11-26)
            self.rid = 'c' + cid.removeprefix('creature-')
        self.ch = REPO / 'local/art/generated/people/dagger-characters' / cid
        self.brief = self.ch / '00-brief'
        self.cut = self.ch / '01-concept/wip/cut'
        self.keys = self.ch / f'01-concept/wip/keys-1920'
        self.clay = self.ch / '02-guide/wip/clay'
        self.mesh = self.ch / '02-guide/wip/mesh-clay'
        self.guide = self.ch / '02-guide/wip/orbit-guide'
        self.scaffold = self.ch / '02-guide/scaffold'
        self.work = self.ch / 'work'
        self.k = self.work / self.rid / 'A'
        self.env = {'CHAR': cid}                           # bound_run.sh and guided_clip.sh: the character folder when it is not the run id

    @property
    def key_env(self):
        """npc.json "backdrop": "R,G,B" - a chroma-key clip (npc-024, 2026-11-23): the keyframes and guide sit on that colour (say it in
        orbit.txt too), and the mattes open every enclosed patch near it and take its spill off the edges."""
        b = self.cfg.get('backdrop')
        return {'BACKDROP': b} if b else {}

    @property
    def cfg(self):
        f = self.brief / 'npc.json'
        c = json.loads(f.read_text()) if f.exists() else {}
        return {**DEFAULTS, **(WALKER if c.get('walker') else {}), **c}

    @property
    def creature(self):
        """npc.json "creature": quadruped, spider or ghost - an animated creature that is not a humanoid (2026-11-26): framed by its
        largest extent (keys, guide), the clay mesh itself as the orbit guide, a body-plan rig and generated gaits."""
        return self.cfg.get('creature')

    @property
    def walker(self):
        return bool(self.cfg.get('walker'))

    @property
    def gpu(self):
        """Where the GPU steps run: npc.json "gpu_host" or --gpu: gpu-lab (the 5090, default) or a Strix Halo, den-m5 or den-nimo
        (Patch 2026-11-24, npc-468's second run: the lengthy work on a Halo, so the lab stays free for him)."""
        g = getattr(self, 'gpu_arg', None) or self.cfg.get('gpu_host', 'gpu-lab')
        if g != 'gpu-lab' and g not in HALOS and not g.startswith(('runpod', 'colab')):
            raise SystemExit(f'gpu_host {g}: gpu-lab, ' + ', '.join(HALOS) + ' or a RunPod or Colab ssh alias runpod-*, colab-* (hosts/runpod/setup.sh)')
        return g

    @property
    def comfy(self):
        return f'http://{HALOS[self.gpu]}:8188' if self.gpu in HALOS else LAB_COMFY   # a RunPod pod has no ComfyUI: the 5090's

    @property
    def gpu_env(self):
        """bake.sh, pipeline.sh and bound_run.sh: GPU= puts their gsplat stages on a Halo; guided_clip.sh: HALO=."""
        # VACE stays on the 5090 (bake.sh's own rule: about 4 min a ring there, a short lab job Patch allows; den-m5's ComfyUI crashed on
        # model loads after gsplat work three times on 2026-11-24)
        # a RunPod pod takes only the gsplat stages (GPU=); the clip (guided_clip.sh HALO=) needs a ComfyUI, so it stays on the 5090 there
        return {} if self.gpu == 'gpu-lab' else {'GPU': self.gpu, **({'HALO': self.gpu} if self.gpu in HALOS else {})}

    def need(self, *paths, step):
        for p in paths:
            if not Path(p).exists():
                raise SystemExit(f'static-npc {self.id}: {Path(p).relative_to(REPO)} is missing; run "{step}" first')

    def prompt(self, name, force=False):
        f = self.brief / name
        self.need(f, step='init')
        if not force and (TEMPLATES / name).exists() and f.read_bytes() == (TEMPLATES / name).read_bytes():
            raise SystemExit(f'static-npc {self.id}: 00-brief/{name} is still 021\'s template; write it for this character '
                             '(or --force to use it as it is)')
        return f

    @property
    def views(self):
        """The paintings this character has: front, back unless it is front-only, and a side painting when npc.json "side" names
        which side it shows (right or left; experiment, npc-471 2026-11-25: Patch's three-view sheet split in three)."""
        # "sides": ["right", "left"] - named side paintings right.png / left.png (a four-view sheet, npc-471's second test)
        return (('front',) if self.cfg.get('front_only') else ('front', 'back')) + (('side',) if self.cfg.get('side') else ()) \
            + tuple(self.cfg.get('sides', ()))

    def clip_dir(self):
        return self.k / 'guided' / f"stick-{self.cfg['size']}"


def step_init(n, a):
    a.cms = a.cms or (n.id if n.id.startswith(('npc-', 'creature-')) else None)
    if not a.cms:
        raise SystemExit('init needs --cms (the CMS character id, e.g. npc-021); name new characters npc-NNN (Patch 2026-11-22)')
    if not n.id.startswith(('npc-', 'creature-')) and not n.ch.exists():
        raise SystemExit(f'name the character by its CMS id: static-npc init npc-{n.id} (Patch 2026-11-22)')
    if not (n.ch / 'character.json').exists():
        sh([REPO / 'authoring/tools/people/splat/character/dagger-char', 'init', n.id, '--name', a.name or n.id])
    ap = n.ch / '01-concept/approved'; ap.mkdir(parents=True, exist_ok=True)
    cfg = n.cfg; cfg.update({'name': a.name or cfg.get('name', n.id), 'cms': a.cms})
    if getattr(a, 'creature', None):
        cfg['creature'] = a.creature
    if a.walker:
        cfg.update(walker=True, **{k: v for k, v in WALKER.items() if k not in cfg or cfg[k] == DEFAULTS.get(k)})
    for v in ('front', 'back'):
        if a.from_dir:   # paintings not approved in the CMS but given by Patch (npc-468: the old 128 pipeline folder's approved pair)
            src = Path(a.from_dir) / f'{v}.png'
            if src.exists():
                shutil.copy(src, ap / f'{v}.png'); continue
            if v == 'back' and not a.back_required:
                cfg['front_only'] = True; print(f'{n.id}: no back in {a.from_dir}; front-only'); continue
            raise SystemExit(f'init --from: {src} is missing')
        r = subprocess.run(['python3', 'authoring/cms/concept_cli.py', '--url', cfg['cms_url'], 'approved', a.cms, '--view', v,
                            '--image', str(ap / f'{v}.png')], cwd=DAGGER, capture_output=True, text=True)
        if r.returncode or not (ap / f'{v}.png').exists():
            if v == 'back' and not a.back_required:   # no approved back: front-only (Patch 2026-11-22, 023)
                cfg['front_only'] = True
                print(f'{n.id}: no approved back in the CMS; front-only (every step takes the front alone)'); continue
            raise SystemExit(f'CMS fetch of {a.cms} {v} failed: {r.stdout[-400:]} {r.stderr[-400:]}')
    if a.from_dir and (Path(a.from_dir) / 'side.png').exists():   # a side painting (experiment, npc-471): which side it shows
        shutil.copy(Path(a.from_dir) / 'side.png', ap / 'side.png'); cfg['side'] = a.side or cfg.get('side') or 'right'
        print(f"{n.id}: side painting ({cfg['side']} side) from {a.from_dir}")
    named = [v for v in ('right', 'left') if a.from_dir and (Path(a.from_dir) / f'{v}.png').exists()]   # her right / left side, by name
    for v in named:
        shutil.copy(Path(a.from_dir) / f'{v}.png', ap / f'{v}.png')
    if not a.from_dir:   # the CMS approves right and left views too (Patch 2026-11-25: four-view sheets, the standard for armed characters)
        for v in ('right', 'left'):
            r = subprocess.run(['python3', 'authoring/cms/concept_cli.py', '--url', cfg['cms_url'], 'approved', a.cms, '--view', v,
                                '--image', str(ap / f'{v}.png')], cwd=DAGGER, capture_output=True, text=True)
            if r.returncode == 0 and (ap / f'{v}.png').exists():
                named.append(v)
    if named:
        cfg['sides'] = named; print(f'{n.id}: side paintings {named} from {a.from_dir or "the CMS"}')
    n.brief.mkdir(parents=True, exist_ok=True)
    (n.brief / 'npc.json').write_text(json.dumps(cfg, indent=1) + '\n')
    for name in BRIEF + (('clay-side.txt',) if cfg.get('side') else ()) + tuple(f'clay-{v}.txt' for v in cfg.get('sides', ())):
        if name == 'clay-back.txt' and cfg.get('front_only'):
            continue
        if not (n.brief / name).exists():
            shutil.copy(TEMPLATES / ('clay-front.txt' if name in ('clay-side.txt', 'clay-right.txt', 'clay-left.txt') else name), n.brief / name)
    print(f'{n.id}: paintings in 01-concept/approved; edit 00-brief/{", ".join(BRIEF)} for this character (they are 021\'s)')


def step_keys(n, a):
    ap = n.ch / '01-concept/approved'; n.need(*(ap / f'{v}.png' for v in n.views), step='init')
    tol = a.tolerance or n.cfg['tolerance']; n.cut.mkdir(parents=True, exist_ok=True)
    for v in n.views:
        sh(['python3', 'authoring/tools/people/splat/mesh-splat/flood_cut.py', 'cut', ap / f'{v}.png', n.cut / f'{v}-cut.png', '--tolerance', str(tol)]
           + (['--open-holes', str(n.cfg['open_holes'])] if n.cfg.get('open_holes') else []))   # npc.json "open_holes": an arm akimbo
    sh(['python3', 'authoring/tools/people/splat/mesh-splat/flood_cut.py', 'keyframes', n.keys] + [f"{v}={n.cut / f'{v}-cut.png'}" for v in n.views]
       + ['--size', '1920', '--height', '1675', '--floor', '1799', '--fit-extent' if n.creature else '--equal-height'])
    print(f'{n.id}: check the cut-outs ({n.cut.relative_to(REPO)}) at full size: tolerance 16 ate a robe edge on 128, 9 is the default')


def step_clay(n, a):
    n.need(n.keys / 'front.png', step='keys'); n.clay.mkdir(parents=True, exist_ok=True)
    for v in n.views:
        p = n.prompt(f'clay-{v}.txt', a.force)
        shutil.copy(n.keys / f'{v}.png', n.clay / f'key-{v}.png'); shutil.copy(p, n.clay / f'prompt-{v}.txt')
        lab = n.gpu == 'gpu-lab'
        lock, res = ('/tmp/gpu-lab-claude.lock', 'lab-comfy') if lab else (f'/tmp/halo-gpu-{n.gpu}.lock', n.gpu.removeprefix('den-') + '-comfy')
        sh(f"flock -w 3600 {lock} asset-resources run --host {n.gpu} --resource {res} --owner claude "
           f"--purpose 'Scaffold clay ({v}) for NPC {n.id}' -- python3 authoring/tools/people/splat/image/qwen_edit.py --image {n.clay}/key-{v}.png "
           f"--prompt \"$(cat {n.clay}/prompt-{v}.txt)\" --resolution 1328 --out {n.clay}/{v}.png", log=n.clay / f'{v}.log',
           env={'COMFY_URL': n.comfy})
    print(f'{n.id}: clay in {n.clay.relative_to(REPO)}; check it keeps the outline before meshing')


def step_mesh(n, a):
    n.need(*(n.clay / f'{v}.png' for v in n.views), step='clay')
    mesher = a.mesher or n.cfg['mesher']; log = n.ch / '02-guide/wip/mesh.log'
    if mesher == 'meshy':
        imgs = ' '.join(f'{n.clay}/{v}.png' for v in n.views)   # the front alone for a front-only character
        rc = sh(f"timeout 900 python3 authoring/tools/people/splat/mesh/meshy_multiview.py {n.mesh} {imgs} "
                f"--pose '' --no-texture", log=log, check=False)
        if rc == 0 and (n.mesh / 'model.glb').exists():
            print(f'{n.id}: Meshy mesh {(n.mesh / "model.glb").relative_to(REPO)}'); return
        text = log.read_text()[-4000:]
        if 'ForbiddenForNSFW' not in text and '403' not in text:
            raise SystemExit(f'Meshy failed (rc {rc}), not a content block; see {log}')
        print(f'{n.id}: Meshy refused the clay (content block); switching to local Hunyuan3D-2mv (Patch 2026-11-22)')
    hy = n.ch / '02-guide/wip/mesh-hy2mv'
    if n.cfg.get('front_only'):
        raise SystemExit(f'{n.id}: Hunyuan3D-2mv here takes a front and a back; a front-only character has no back clay')
    sh([AP / 'tools/fast-bound/fast-bound', 'scaffold',   # asset-pipeline's fast-bound, as a tool on files
        '--front', n.clay / 'front.png', '--back', n.clay / 'back.png', '--out', hy,
        '--mesher', 'hy2mv', '--rigger', 'none', '--stop-after', 'mesh'], log=log)
    glbs = sorted(p for p in hy.rglob('*.glb') if 'scaffold' not in p.name)
    if not glbs:
        raise SystemExit(f'Hunyuan3D-2mv gave no mesh; see {log}')
    n.mesh.mkdir(parents=True, exist_ok=True); shutil.copy(glbs[0], n.mesh / 'model.glb')
    (n.mesh / 'mesher.txt').write_text(f'hy2mv: {glbs[0]}\n')
    print(f'{n.id}: Hunyuan3D-2mv mesh {(n.mesh / "model.glb").relative_to(REPO)}')


def step_rig(n, a):
    n.need(n.mesh / 'model.glb', step='mesh'); n.scaffold.mkdir(parents=True, exist_ok=True); n.guide.mkdir(parents=True, exist_ok=True)
    if n.creature:
        raise SystemExit(f'{n.id}: the {n.creature} rig template is still to be built (2026-11-26); the guide uses the clay mesh, so go on to guide')
    if n.walker:
        return rig_walker(n, a)
    sh(['python3', 'authoring/tools/people/splat/scaffold/static_rig.py', n.mesh / 'model.glb', n.scaffold / 'scaffold.glb', '--report', n.scaffold / 'scaffold.json',
        '--stick', n.guide / 'fit-static.json', '--view-yaw', str(n.cfg.get('view_yaw', 'auto')),
        '--front', n.cut / 'front-cut.png'] + (['--back', n.cut / 'back-cut.png'] if 'back' in n.views else [])
       + (['--head-axis', str(n.cfg['head_axis'])] if n.cfg.get('head_axis') else [])
       + ['--hands', str(n.cfg.get('hands', 'front'))]
       + (['--body-axis'] if n.cfg.get('body_axis') else []) + (['--prop-hand', n.cfg['prop_hand']] if n.cfg.get('prop_hand') else [])
       + (['--wide', str(n.cfg['head_wide'])] if n.cfg.get('head_wide') else []) + (['--elbows', n.cfg['elbows']] if n.cfg.get('elbows') else []),
       log=n.scaffold / 'rig.log')   # npc.json body_axis, prop_hand: a staff held to one side and above the head (npc-026)
    rep = json.loads((n.scaffold / 'scaffold.json').read_text())
    print(f"{n.id}: {rep['joints']} joints, {rep['triangles']:,} triangles; mesh vertices each joint leads: {rep['dominant']}")
    print(f"  paintings' view {rep['view_yaw']} degrees round to the right of the mesh's front"
          + (f" (outline IoU {rep['view_yaw_iou']['best']}, square {rep['view_yaw_iou']['square']})" if 'view_yaw_iou' in rep else '')
          + '; the stick guide opens there (npc.json "view_yaw" sets it)')
    hz = rep.get('head_zone_on_head')
    print(f'  head zone (above the Neck joint) led by Neck/Head: {hz}' + ('  <- LOW: a face that tears in the look clip (017); check the '
          'hands and the head axis (npc.json head_axis)' if hz is not None and hz < 0.97 else ''))
    print('  check the hands sit on what he holds, and that a hood or hat goes with Head (rig.log); scaffold_views.py renders it')


def rig_walker(n, a):
    """Meshy's API rig (it needs the Meshy task of the mesh step: a Hunyuan3D-2mv mesh has none) and donor hands at the cuffs,
    as batch 2's scaffold.sh did."""
    rig = n.ch / '02-guide/wip/rig-meshy'; log = n.scaffold / 'rig.log'
    rigger = getattr(a, 'rigger', None) or n.cfg.get('rigger', 'meshy')
    if rigger == 'meshy' and not (n.mesh / 'task.json').exists():   # a Hunyuan3D-2mv mesh (Meshy's content block) has no Meshy task to rig
        print(f'{n.id}: no Meshy mesh task ({n.mesh}/task.json): fitting the target skeleton instead (fit_rig.py; npc-467, 2026-11-25)'); rigger = 'fit'
    if rigger == 'meshy':
        rc = sh(['python3', 'authoring/tools/people/splat/mesh/meshy_rig.py', n.mesh, rig], log=log, check=False)
        if rc:
            if 'pose estimation' not in log.read_text()[-2000:]:
                raise SystemExit(f'static-npc: Meshy rig failed (rc {rc}); see {log}')
            # npc-468's pose-locked painting (2026-11-24): arms hanging beside an ankle-length robe; Meshy's estimator refused it twice
            print(f'{n.id}: Meshy could not estimate the pose; fitting the target skeleton instead (fit_rig.py)'); rigger = 'fit'
    if rigger == 'fit':
        src = rig / 'remesh.glb' if (rig / 'remesh.glb').exists() else n.mesh / 'model.glb'
        rig.mkdir(parents=True, exist_ok=True)
        sh(['blender', '-b', '-P', AP / 'tools/splat-rig/fit_rig.py', '--', src, FIT_TEMPLATE, rig / 'rigged-glb.glb', '--report', rig / 'fit.json']
           + (['--rigid-prop', n.cfg['rigid_prop']] if n.cfg.get('rigid_prop') else []), log=log)   # npc.json "rigid_prop": Right|Left, a staff painted in hand (npc-467)
    # donor hands replace a mesher's mitten hands (Meshy, batch 2); a fitted rig keeps the mesher's own hands, which follow a
    # pose-locked painting's relaxed hands (npc-468, 2026-11-24; the Engine GLB has no finger joints either way). npc.json "donor_hands"
    donor = n.cfg.get('donor_hands', rigger == 'meshy')
    sh(['python3', 'authoring/tools/people/splat/scaffold/transplant_hands.py', rig / 'rigged-glb.glb', DONOR_HANDS, n.scaffold / 'scaffold.glb',
        '--report', n.scaffold / 'scaffold.json'] + ([] if donor else ['--keep-hands']), log=log)
    chk = n.ch / '02-guide/wip/check'
    sh(['blender', '-b', '-P', 'authoring/tools/people/splat/scaffold/scaffold_views.py', '--', n.scaffold / 'scaffold.glb', chk], log=log, check=False)
    rep = json.loads((n.scaffold / 'scaffold.json').read_text())
    print(f"{n.id}: walker scaffold {(n.scaffold / 'scaffold.glb').relative_to(REPO)}: {json.dumps(rep)[:300]}")
    print(f'  look at {chk.relative_to(REPO)} (rest and walk views): the hands at the cuffs, the hood with the head, nothing fused')


