def walk_names(n, sizes=None):
    """A walker's runtime sizes as the walk step leaves them: (base, after skirt, after tidy), the graft last."""
    cfg = n.cfg; sk = '-skirt' if cfg.get('skirt') else ''; out = []
    for count in sizes or cfg['sizes']:
        for base in (f'{count // 1000}k-face-share-cleaned', f'{count // 1000}k-graft'):
            if (n.k / 'bound/sizes' / base / 'splat.npz').exists():
                out.append((base, base + sk, base + sk + '-tidy'))
    return out


def step_walk(n, a):
    if not n.walker:
        raise SystemExit(f'{n.id} is static: preview renders its idle and look clips')
    cfg = n.cfg; n.need(n.k / 'bound/bound-cleaned/splat.npz', step='bound')
    b = ['authoring/tools/people/splat/scaffold/bound_run.sh', n.work, f'{n.rid}-A']
    env = {**n.env, **n.gpu_env, 'SKIRT_BONES': str(cfg.get('skirt_bones', 8)) if cfg.get('skirt') else '', 'SKIRT_OPTS': cfg.get('skirt_opts', '--solid 3'),
           **({'SKIRT_RIG_OPTS': cfg['skirt_rig_opts']} if cfg.get('skirt_rig_opts') else {}),
           **({'SKIRT_DRIVE_OPTS': cfg['skirt_drive_opts']} if cfg.get('skirt_drive_opts') else {})}
    if cfg.get('clips_dir'):   # the character's own walking/around clips (npc-467: the staff arm held as painted)
        env['CLIPS'] = str(n.ch / cfg['clips_dir'])
    names = walk_names(n, [int(x) for x in a.sizes.split(',')] if a.sizes else None)
    for base, skirted, tidy in names:
        if skirted != base:
            sh(b + ['skirt', base], env=env)      # skirt bones under Hips (two tiers, a cloth sheet per clip), the legs inside dropped
        sh(b + ['clips', skirted], env=env)       # Mixamo Walking and Around on the bench, rendered on the GPU lab
        sh(b + ['tidy', skirted], env=env)        # drop the Gaussians that came loose in the clips
        sh(b + ['clips', tidy], env={**env, 'CLIPS_TAG': '-tidy'})
        C = n.k / 'bound/clips-tidy'
        sh(['python3', 'authoring/tools/people/splat/scaffold/clip_compare.py', 'videos', C / 'data', C / 'renders', '--name', f'{n.rid}-400k-and-16k',
            '--grid', 'bound400k=bound 400k (tidy),body=runtime body (tidy)', '--views', 'quarter,close,face,back-quarter',
            '--stills', 'walking:10:quarter', 'walking:10:close', 'walking:20:quarter', 'walking:24:back-quarter', 'around:120:quarter', 'walking:10:face'],
           log=n.k / 'bound/walk.log', check=False)
        print(f'{n.id}: {tidy} walks; stills in {(C / "data/videos").relative_to(REPO)}')
    print(f'{n.id}: run publish to put the walking sizes in the Workbench')


def step_hands(n, a):
    """Re-rest the hands (turn_hands.py): along the forearm, thumb forward, on the full bake, each runtime size and its graft, after
    graft and before walk. For a painting with open, palm-forward hands (npc-468, Patch 2026-11-23: a goofy hand orientation in
    the clips). Needs transplant_hands.py's report, so a walker's rig."""
    rep = n.scaffold / 'scaffold.json'
    if 'Left' not in json.loads(rep.read_text()):
        raise SystemExit(f'{n.id}: no transplanted hands in {rep}: the hands step turns donor hands (a walker\'s rig)')
    b = n.k / 'bound'; dirs = [b / 'bound-cleaned'] + [b / 'sizes' / x for base, _, _ in walk_names(n) for x in [base]]
    for d in dirs:
        if (d / 'turn.json').exists() and not getattr(a, 'from_turned', None):
            print(f'{n.id}: {d.name} already turned'); continue
        tmp = d.with_name(d.name + '.turned'); shutil.rmtree(tmp, ignore_errors=True)
        sh(['python3', 'authoring/tools/people/splat/scaffold/turn_hands.py', d, n.scaffold / 'scaffold.glb', b / 'score/transform.json', rep, tmp,
            '--straighten', str(n.cfg.get('hands_straighten', 1.0)), '--turn', str(n.cfg.get('hands_turn', 1.0))]
           + (['--from-turned', a.from_turned] if getattr(a, 'from_turned', None) else []), log=b / 'hands.log')
        for f in d.iterdir():   # what the turn did not write (logs, reports) goes along
            if not (tmp / f.name).exists():
                shutil.copy2(f, tmp / f.name)
        shutil.rmtree(d); tmp.rename(d)
        print(f"{n.id}: {d.name} hands turned {json.loads((d / 'turn.json').read_text())}")
    print(f'{n.id}: run walk')


def step_publish(n, a):
