{
  "project": "rusty-dagger-authoring",
  "serve": {
    "command": "exec python3 server.py --host {host} --port {port}",
    "preferredPort": 8784,
    "healthUrl": "/health",
    "readyText": "Rusty Dagger Authoring",
    "reusePolicy": "broker_owned",
    "startupTimeout": "20s",
    "healthInterval": "250ms"
  }
}
